# ==============================================================================
# TACTICAL COMMAND: WARS OF LEGACY - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or set in Vercel Project Settings.

# --- Vercel Environment Configuration ---
VITE_APP_ENV="production"                      # 'production' | 'preview' | 'development'
VITE_APP_URL="https://tactical-command.vercel.app"
VITE_VERCEL_ENV="production"
VITE_APP_VERSION="1.0.0"

# --- Supabase Database & Realtime (Client Side) ---
# Project Settings -> API in your Supabase Dashboard
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# --- Supabase Server Role (Vercel Edge/Serverless Functions Only) ---
# DO NOT prefix with VITE_ to keep confidential from client bundles
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# --- Performance & Asset Optimization ---
VITE_ENABLE_PERF_MONITOR="true"                # Enables FPS and render profiling in dev/QA
VITE_ASSET_CDN_URL=""                          # Optional Cloudflare/AWS CloudFront CDN URL for WebP textures
VITE_AUDIO_ENABLED="true"                      # Enable Web Audio API sound synthesizer
VITE_ENABLE_ANALYTICS="false"

# --- AI Studio / Gemini Integration (Optional Server-Side Proxy) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://tactical-command.vercel.app"
