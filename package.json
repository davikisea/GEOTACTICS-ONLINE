  "scripts": {
    "dev": "npx vite --port=3000 --host=0.0.0.0",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); } catch (e) {}\"",
    "test:e2e": "npx tsx src/engine/e2eIntegration.test.ts",
    "test:paso1": "npx tsx src/engine/subActionsAndArrow.test.ts",
    "test:paso2": "npx tsx src/engine/advancedTactics.test.ts",
    "test:paso3": "npx tsx src/engine/expandedCOs.test.ts",
    "test:paso4": "npx tsx src/engine/advancedWarsWorldSystems.test.ts",
    "test:pve": "npx tsx src/engine/autonomousOrchestrator.test.ts",
    "test:sprint3": "npx tsx src/engine/deckAndSupply.test.ts",
    "test:procgen": "npx tsx src/engine/proceduralMapGenerator.test.ts",
    "test:all": "npx tsx src/engine/subActionsAndArrow.test.ts && npx tsx src/engine/advancedTactics.test.ts && npx tsx src/engine/expandedCOs.test.ts && npx tsx src/engine/advancedWarsWorldSystems.test.ts && npx tsx src/engine/autonomousOrchestrator.test.ts && npx tsx src/engine/deckAndSupply.test.ts && npx tsx src/engine/e2eIntegration.test.ts",
    "lint": "npx tsc --noEmit"
  },
  "dependencies": {
